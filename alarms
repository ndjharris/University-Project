g = open("alarms")

text = str(g.read())
newLines = []
lines = text.splitlines()

for line in lines:
    if line[0] == "0":
        if line[2] == "0":
            number = line[3]
        else:
            number = line[2:4]
        alarmText = line[5:]
        newLine = number + " : \"" + alarmText +"\","
        newLines.append(newLine)

newText = "\n".join(newLines)


with open("finished.txt","w") as f:
    f.write(str(newText))